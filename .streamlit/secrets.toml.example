# For Streamlit Community Cloud: paste this into  App settings -> Secrets  (never commit real keys).
GROQ_API_KEY = "paste-your-groq-key"
GEMINI_API_KEY = "paste-your-gemini-key"
LLM_PROVIDER = "groq"
USER_NAME = "Your Name"
TIMEZONE = "Asia/Kolkata"

# Strongly recommended on a public URL, otherwise anyone with the link can use your app and your AI quota.
APP_PASSWORD = "choose-a-password"

# Do NOT add GMAIL_* secrets to a public deployment: emails stay safe previews.
