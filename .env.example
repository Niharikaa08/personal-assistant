# Copy this file to .env and fill in at least one key. No quotes, no spaces.

# Free key: https://console.groq.com/keys
GROQ_API_KEY=
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Which provider to try first (the other is the automatic fallback)
LLM_PROVIDER=groq

# Leave these two EMPTY: the app picks a model that is currently available.
# Model names get retired (Groq retired llama-3.3-70b-versatile in Aug 2026), so pinning one is risky.
GROQ_MODEL=
GEMINI_MODEL=

USER_NAME=Student
TIMEZONE=Asia/Kolkata

# Optional: asks for a password before the app opens (recommended for a public URL)
APP_PASSWORD=

# Optional: real email sending (Gmail app password). Leave empty to keep emails as safe previews.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
